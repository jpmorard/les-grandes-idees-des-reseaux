{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l25_robustness_results.schema.json",
  "title": "Network book L25 distribution-shift retained evidence",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "question",
    "evidence_scope",
    "frozen_candidate",
    "training_seeds",
    "evaluation_seeds",
    "acceptance_contract",
    "training_runs",
    "declared_scenario_results",
    "final_challenge",
    "robustness_outcome",
    "success_criteria"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "experiment_id": {"const": "network-book-l25-distribution-shift-v1"},
    "training_seeds": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"type": "integer"}
    },
    "evaluation_seeds": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "uniqueItems": true,
      "items": {"type": "integer"}
    },
    "training_runs": {"type": "array", "minItems": 5, "maxItems": 5},
    "declared_scenario_results": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "final_challenge": {
      "type": "object",
      "required": [
        "sealed_scenario_sha256",
        "open_count",
        "used_for_selection_or_retuning",
        "result"
      ],
      "properties": {
        "open_count": {"const": 1},
        "used_for_selection_or_retuning": {"const": false}
      }
    },
    "success_criteria": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    }
  },
  "additionalProperties": true
}
