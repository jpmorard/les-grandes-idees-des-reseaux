{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark_results.schema.json",
  "title": "Network book ML/RL retained evidence",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "evidence_scope",
    "training_seeds",
    "evaluation_seeds",
    "baselines",
    "dqn_runs",
    "dqn_summary",
    "paired_summary",
    "hard_constraint_probe",
    "rare_classification",
    "success_criteria",
    "negative_findings"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "benchmark_id": {"const": "network-book-ml-rl-evidence-v1"},
    "training_seeds": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "integer"}
    },
    "evaluation_seeds": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": {"type": "integer"}
    },
    "dqn_runs": {"type": "array", "minItems": 5},
    "negative_findings": {"type": "array", "items": {"type": "string"}},
    "success_criteria": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    }
  },
  "additionalProperties": true
}
